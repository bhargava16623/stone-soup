# PayPal sandbox — developer.paypal.com → Apps & Credentials (Sandbox) → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox accounts — developer.paypal.com → Testing Tools → Sandbox Accounts
SANDBOX_VENDOR_EMAIL=     # a sandbox BUSINESS account (plays "Sunrise Supplies")
SANDBOX_NGO_EMAIL=        # a second sandbox BUSINESS account (plays "Hope Shelter")
# Channel3 — trychannel3.com dashboard
CHANNEL3_API_KEY=
# Google Gemini — aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=            # optional; default gemini-3.8-flash, falls back to 3.5-flash-lite, 2.5-flash

# Postgres (local: docker compose up -d)
DATABASE_URL=postgres://stonesoup:stonesoup@localhost:5433/stonesoup
# Same as PAYPAL_CLIENT_ID; exposed to the browser for the PayPal button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# PayPal webhook ID (developer dashboard → your app → Webhooks), after the app has a public URL
PAYPAL_WEBHOOK_ID=
# Shared secret for the monthly Soup Club job (POST /api/club/run)
CRON_SECRET=

# Public https address of the site, used in links sent to PayPal and AI assistants (optional locally)
PUBLIC_BASE_URL=

# Signs the reviewer and charity-owner cookies (any long random string: `openssl rand -base64 32`)
SESSION_SECRET=
# Key a Stone Soup reviewer enters on /review to approve charities and flagged deliveries
REVIEW_KEY=
